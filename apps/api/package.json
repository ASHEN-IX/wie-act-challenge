{
  "name": "api",
  "version": "1.0.0",
  "description": "EdNova modular monolith",
  "private": true,
  "scripts": {
    "worker:formula": "tsx --tsconfig tsconfig.json scripts/formula-recognition-worker.ts",
    "seed:users": "tsx seeds/demo-users.seed.ts",
    "seed:learning-demo": "tsx --tsconfig tsconfig.json seeds/learning-demo.seed.ts",
    "seed:demo-course": "tsx --tsconfig tsconfig.json seeds/demo-course.seed.ts",
    "seed:ednova-phase2": "tsx --tsconfig tsconfig.json seeds/ednova-phase2-demo.seed.ts",
    "dev": "pnpm build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "build": "tsc",
    "lint": "eslint modules shared scripts tests src --ignore-pattern \"**/node_modules/**\" --ext .ts",
    "test": "pnpm test:routes && jest --runInBand && pnpm test:node && pnpm test:node:integration && pnpm test:auth",
    "test:unit": "jest modules src shared --runInBand",
    "test:integration": "jest tests/integration --runInBand && pnpm test:node:integration",
    "format": "prettier --write \"{src,modules,shared,scripts,tests}/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"{src,modules,shared,scripts,tests}/**/*.{ts,json,md}\"",
    "seed:rank-badges": "npx tsx seeds/rank-badges.seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:auth": "pnpm build && npx tsx --test tests/better-auth.lifecycle.ts tests/better-auth.nest.ts",
    "auth:migrate": "npx tsx scripts/migrate-auth.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "pretest": "pnpm build",
    "generate:contracts": "tsx scripts/generate-http-contracts.ts",
    "test:routes": "tsx --test tests/routes.node.ts",
    "test:node": "tsx --tsconfig tsconfig.json --test tests/*.node.test.ts",
    "test:node:integration": "AI_SERVICE_URL=http://127.0.0.1:1 tsx --tsconfig tsconfig.json --test --test-concurrency=2 tests/integration/*.node.test.ts tests/integration/ed07-study-rooms-e2e-real.test.ts tests/integration/ed09-facilitator.integration.test.ts"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "amqplib": "^0.10.9",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": "11.3.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@ednova/ai-orchestrator-service": "workspace:*",
    "@ednova/analytics-service": "workspace:*",
    "@ednova/auth-service": "workspace:*",
    "@ednova/notification-service": "workspace:*",
    "@ednova/shared": "workspace:*",
    "@ednova/signal-processing-service": "workspace:*",
    "@ednova/study-service": "workspace:*",
    "@ednova/user-profile-service": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.7.7",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.5.2",
    "katex": "^0.19.1",
    "mongodb": "^7.7.0",
    "mongoose": "^8.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node20",
    "moduleResolution": "Node16",
    "noEmit": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "modules/**/*.ts",
    "seeds/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}

# Main API / monolith (Node 24, pnpm 11.3.0)
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/ednova
# Optional Compose override, e.g. your existing Atlas URI:
DOCKER_MONGODB_URI=mongodb://mongodb:27017/ednova
INTERNAL_API_SECRET=replace-with-a-third-random-secret
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
RABBITMQ_USER=ednova
RABBITMQ_PASS=replace-with-a-random-password
RABBITMQ_VHOST=ednova
RABBITMQ_URL=amqp://ednova:replace-with-a-random-password@localhost:5672/ednova
# Independent Python server: never built or started by the main API.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=30000
# Billing: provide both keys or leave both empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_TEST_COUPONS=true
COUPON_CODES=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EdNova <noreply@ednova.app>
SMTP_FROM=EdNova <noreply@ednova.app>
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_DB_TIMEOUT_MS=8000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=10000

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional Study Together voice service. The URL must be reachable by browsers.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Registered LiveKit agent worker name for on-demand moderator requests.
LIVEKIT_MODERATOR_AGENT_NAME=

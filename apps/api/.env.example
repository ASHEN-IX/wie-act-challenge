# Noveris API (Node 24, pnpm). Copy to apps/api/.env. This is the ONE env file for the
# API and for `pnpm docker:up` (Compose reads it through --env-file); do not keep a second copy
# at the repo root (a symlink `.env -> apps/api/.env` is fine for plain `docker compose`).
#
# Values that MUST be identical in the other apps (see docs/environment.md):
#   DATABASE_URL, BETTER_AUTH_SECRET, BETTER_AUTH_URL, AUTH_TRUSTED_ORIGINS -> apps/web/.env.local
#   RABBITMQ_URL, AI_SERVICE_API_KEY, INGEST_UPLOADS_DIR, FAISS_INDEX_DIR   -> apps/ai/.env
NODE_ENV=development
PORT=3001
# PostgreSQL. Prisma migrations own the schema; the API never creates tables itself.
DATABASE_URL=postgresql://ednova:ednova@localhost:5433/ednova
# Compose creates these roles/database from the same values.
POSTGRES_USER=ednova
POSTGRES_PASSWORD=ednova
POSTGRES_DB=ednova
# Connection pool and timeouts (milliseconds) for the Prisma pg adapter.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
# The Python AI service still owns its own MongoDB collections.
MONGODB_URI=mongodb://localhost:27017/ednova
# Database name the AI workers use (Compose). Keep equal to the database in MONGODB_URI.
AI_DB_NAME=ednova
INTERNAL_API_SECRET=replace-with-a-third-random-secret
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
RABBITMQ_USER=ednova
RABBITMQ_PASS=replace-with-a-random-password
RABBITMQ_VHOST=ednova
RABBITMQ_URL=amqp://ednova:replace-with-a-random-password@localhost:5672/ednova
# Independent Python server: never built or started by the main API.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=30000
# Billing: provide both keys or leave both empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_TEST_COUPONS=true
COUPON_CODES=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Noveris <noreply@noveris.app>
SMTP_FROM=Noveris <noreply@noveris.app>
EMAIL_NOTIFICATIONS_ENABLED=false
NOTIFICATION_DB_TIMEOUT_MS=8000


BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional Study Together voice service. The URL must be reachable by browsers.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Registered LiveKit agent worker name for on-demand moderator requests.
LIVEKIT_MODERATOR_AGENT_NAME=

# Absolute host paths shared with the AI containers (Compose bind-mounts both). They must be
# the same directories the API writes to, or the ingestion worker cannot see uploads.
INGEST_UPLOADS_DIR=/absolute/path/to/apps/api/uploads
FAISS_INDEX_DIR=/absolute/path/to/apps/api/var/faiss

# Local demo seeds refuse to run unless this is set (never set it in production).
ALLOW_DEMO_COURSES=

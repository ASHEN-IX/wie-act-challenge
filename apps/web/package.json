{
  "name": "web",
  "version": "1.0.0",
  "description": "EdNova native Next.js App Router workspace",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5173",
    "start": "next start --port 5173",
    "build": "next build --webpack",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:integration": "AUTH_E2E=1 playwright test e2e/workspace.spec.ts",
    "test:all": "pnpm test && pnpm test:auth:e2e",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth:e2e": "AUTH_E2E=1 playwright test e2e/better-auth.spec.ts e2e/smoke.spec.ts e2e/workspace.spec.ts --reporter=list"
  },
  "dependencies": {
    "@study-partner/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.4.1",
    "postcss": "^8.5.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "set-cookie-parser": "^3.1.4",
    "shadcn": "^4.22.0",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/set-cookie-parser": "^2.4.10",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "mongodb": "^7.7.0",
    "bcryptjs": "^2.4.3"
  },
  "packageManager": "pnpm@11.3.0"
}

# Server-only settings, never prefix credentials with NEXT_PUBLIC_.
MONGODB_URI=mongodb://localhost:27017/ednova
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000
BACKEND_URL=http://localhost:3001
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional public non-secret API/WS locations; same-origin defaults preferred.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

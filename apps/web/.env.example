# EdNova web (Next.js). Copy to apps/web/.env.local.
#
# The web app does two jobs, which is why it needs a database URI and a secret:
#   1. It serves the UI and proxies /api/v1, /ws and /uploads to the API (BACKEND_URL).
#   2. It HOSTS the sign-in endpoints (/api/auth/*, Better Auth). Those talk to MongoDB
#      directly, and the API verifies the same sessions with the same secret.
# So every value in the "shared with the API" block must equal the one in apps/api/.env.

# --- Where the API lives (server side only)
BACKEND_URL=http://localhost:3001

# --- Shared with the API: must be identical to apps/api/.env
DATABASE_URL=postgresql://ednova:ednova@localhost:5433/ednova
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# --- Sign-in emails (verification, reset). Same SMTP as the API; local Mailpit by default.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=EdNova <noreply@ednova.app>

# --- Optional, public, non-secret. Leave empty to use same-origin defaults.
# Browser WebSocket origin for Study Together (defaults to BACKEND_URL with ws://).
NEXT_PUBLIC_WS_URL=
# Absolute site URL for metadata.
NEXT_PUBLIC_SITE_URL=

# EdNova AI service (FastAPI + workers). Copy to apps/ai/.env.
# Compose overrides AI_DATABASE_URL, RABBITMQ_URL and REDIS_URL with container hostnames; the
# values below are for running the service directly on the host.
#
# Must match the API (apps/api/.env): RABBITMQ_URL, AI_SERVICE_API_KEY,
# INGEST_UPLOADS_DIR, FAISS_INDEX_DIR, and INTERNAL_API_SECRET.
#
# AI_DATABASE_URL is PostgreSQL for the AI service's own tables (schema `ai`, created on
# first use). Application data (courses, plans, ingestion state, the LLM budget ledger) is
# read from the API over HTTP at API_SERVICE_URL, authenticated with INTERNAL_API_SECRET.
AI_DATABASE_URL=postgresql://ednova:ednova@localhost:5433/ednova
API_SERVICE_URL=http://localhost:3001
INTERNAL_API_SECRET=
RABBITMQ_URL=amqp://ednova:replace-with-a-random-password@localhost:5672/ednova
REDIS_URL=redis://localhost:6379/0
# At least 32 characters; the API sends it, the service checks it.
AI_SERVICE_API_KEY=
INGEST_UPLOADS_DIR=/absolute/path/to/apps/api/uploads
FAISS_INDEX_DIR=/absolute/path/to/apps/api/var/faiss

# LLM providers. Leave LLM_MOCK=1 to run without any provider key.
LLM_MOCK=0
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# External inference needs an approval per task (see docs/llm-config.md); JSON object.
LLM_APPROVALS_JSON=
# The durable request ledger is owned by the API (reached via API_SERVICE_URL).

GEMINI_API_KEY=your_key_here
# Nardouch uses the existing LLM approvals and durable usage budgets.
NARDOUCH_COMPACT_MODEL=groq/openai/gpt-oss-20b
NARDOUCH_CAPABLE_MODEL=groq/openai/gpt-oss-120b
NARDOUCH_CONCURRENCY=4
# Optional trusted prompt JSON override (same schema as agents/nardouch/prompts.json).
# NARDOUCH_PROMPTS_PATH=/absolute/path/nardouch-prompts.json
# Whisper remains local; ElevenLabs is an explicit metered demo TTS option.
NARDOUCH_ASR_PROVIDER=local_whisper
NARDOUCH_ASR_DEVICE=cpu
NARDOUCH_ASR_COMPUTE_TYPE=int8
NARDOUCH_ASR_LANGUAGE=auto
# local_silma is recognized but remains blocked until checkpoint/runtime/voice review.
# local_tunisian remains the optional VoxCPM alternative.
NARDOUCH_TTS_PROVIDER=elevenlabs
NARDOUCH_TTS_DEVICE=cpu
NARDOUCH_SPEECH_MODEL_DIR=/models/nardouch
NARDOUCH_SPEECH_TIMEOUT_SECONDS=18
# Local model workers remain offline; ElevenLabs runs separately at the private HTTP boundary.

NARDOUCH_PIPER_DEVICE=cpu
# Optional override; defaults to NARDOUCH_SPEECH_MODEL_DIR/piper
# NARDOUCH_PIPER_MODEL_DIR=/models/nardouch/piper
# Research-only voice requires explicit opt-in and is always refused in production.
NARDOUCH_PIPER_ALLOW_NONCOMMERCIAL=0

# Explicit demo external TTS. No voice ID is assumed or invented.
NARDOUCH_TTS_DEMO_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
NARDOUCH_TTS_MAX_CHARACTERS=600
NARDOUCH_TTS_DAILY_CHARACTERS=3000
NARDOUCH_TTS_DAILY_REQUESTS=10
# Mandatory persistent private accounting location (never delete to retry a request).
NARDOUCH_TTS_BUDGET_DB=/models/nardouch-demo-state/elevenlabs.sqlite3

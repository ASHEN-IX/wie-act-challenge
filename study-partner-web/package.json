{
  "name": "study-partner-web",
  "version": "1.0.0",
  "description": "Study Partner Next.js frontend with Better Auth",
  "private": true,
  "scripts": {
    "dev": "next dev --port 5173",
    "start": "next start --port 5173",
    "build": "next build --webpack",
    "preview": "next start --port 5173",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "test:unit": "vitest run src/__tests__",
    "test:integration": "vitest run src/tests/integration",
    "test:all": "vitest run",
    "test:smoke": "playwright test e2e/smoke.spec.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/**/*.{js,jsx,css}",
    "format:check": "prettier --check src/**/*.{js,jsx,css}",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:auth:e2e": "AUTH_E2E=1 playwright test e2e/better-auth.spec.ts e2e/smoke.spec.ts --reporter=list"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@study-partner/shared": "workspace:*",
    "autoprefixer": "^10.4.24",
    "axios": "^1.13.5",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.34.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.563.0",
    "next": "^16.4.0",
    "ogl": "^1.0.11",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-query": "^3.39.3",
    "react-toastify": "^10.0.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^8.56.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.1.1",
    "react-router-dom": "^6.21.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.1"
  },
  "vitest": {
    "test": {
      "globals": true,
      "environment": "jsdom",
      "setupFiles": "./src/setupTests.ts",
      "include": [
        "src/**/*.{test,spec}.{js,jsx,ts,tsx}"
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "globals": {
      "vi": "readonly",
      "describe": "readonly",
      "it": "readonly",
      "test": "readonly",
      "expect": "readonly",
      "beforeAll": "readonly",
      "afterAll": "readonly",
      "beforeEach": "readonly",
      "afterEach": "readonly",
      "jest": "readonly"
    },
    "overrides": [
      {
        "files": [
          "e2e/**/*.js",
          "e2e/**/*.spec.js"
        ],
        "rules": {
          "testing-library/prefer-screen-queries": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "pnpm@11.3.0"
}

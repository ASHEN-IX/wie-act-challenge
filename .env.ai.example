# Optional, independently operated Python AI deployment.
# Preserve the AI server's existing database and broker settings.
AI_MONGODB_URI=mongodb://host.docker.internal:27017
AI_DB_NAME=study_partner
AI_RABBITMQ_URL=amqp://user:password@your-broker:5672/your-vhost
# Shared persistent Redis is mandatory for containerized worker leases/dedup.
AI_REDIS_URL=redis://your-redis:6379/0
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
LLM_MOCK=0
# Optional durable request ledger for separately approved external inference.
# Set both values to the same protected database for every HTTP and worker instance.
LLM_BUDGET_MONGODB_URI=
LLM_BUDGET_DB_NAME=

# Optional, independently operated Python AI deployment.
# Preserve the AI server's existing database and broker settings.
# PostgreSQL for the AI service's own tables (schema `ai`, created on first use).
AI_DATABASE_URL=postgresql://ednova:replace-with-a-random-password@host.docker.internal:5433/ednova
# The API the AI service reads application data from, and the shared secret.
API_SERVICE_URL=http://host.docker.internal:3001
INTERNAL_API_SECRET=
AI_RABBITMQ_URL=amqp://user:password@your-broker:5672/your-vhost
# Shared persistent Redis is mandatory for containerized worker leases/dedup.
AI_REDIS_URL=redis://your-redis:6379/0
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
LLM_MOCK=0
# The durable request ledger for approved external inference lives in the API's
# PostgreSQL database; the AI service reaches it through API_SERVICE_URL.

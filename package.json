{
  "name": "mindflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter study-partner-api --filter study-partner-web dev",
    "start": "pnpm --filter study-partner-api start",
    "build": "pnpm --filter study-partner-api --filter study-partner-web build",
    "test": "pnpm --filter study-partner-api test && pnpm --filter study-partner-web test",
    "test:integration": "pnpm --filter study-partner-api test:integration",
    "test:e2e": "pnpm --filter study-partner-web test:auth:e2e",
    "lint": "pnpm --filter study-partner-api --filter study-partner-web lint",
    "typecheck": "pnpm --filter study-partner-api --filter study-partner-web typecheck",
    "docker:up": "docker compose --env-file study-partner-api/.env up -d",
    "docker:down": "docker compose --env-file study-partner-api/.env down",
    "test:infra:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f docker-compose.test.yml down",
    "test:auth": "pnpm --filter study-partner-api test:auth"
  }
}

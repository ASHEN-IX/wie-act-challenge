{
  "name": "ednova",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.3.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "start": "pnpm --filter api start",
    "build": "pnpm --filter api --filter web build",
    "test": "pnpm --filter api test && pnpm --filter web test",
    "test:integration": "pnpm --filter api test:integration",
    "test:e2e": "node scripts/run-integrated-browser.mjs --auth",
    "lint": "pnpm --filter api --filter web lint",
    "typecheck": "pnpm --filter api --filter web typecheck",
    "docker:up": "docker compose --env-file apps/api/.env up -d",
    "docker:down": "docker compose --env-file apps/api/.env down",
    "test:infra:up": "docker compose -f deploy/compose.test.yml up -d --wait",
    "test:infra:down": "docker compose -f deploy/compose.test.yml down",
    "test:auth": "pnpm --filter api test:auth",
    "dev:infra:up": "docker compose -f deploy/compose.development.yml up -d --wait",
    "dev:infra:down": "docker compose -f deploy/compose.development.yml down",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "generate:contracts": "pnpm --filter api generate:contracts",
    "dev:setup": "node scripts/setup.mjs",
    "dev:doctor": "node scripts/doctor.mjs",
    "dev:ai": "node scripts/run-ai.mjs",
    "dev:worker": "node scripts/run-ai.mjs worker",
    "seed": "pnpm --filter api exec tsx seeds/complete-demo.seed.ts"
  }
}
